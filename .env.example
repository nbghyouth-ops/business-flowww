# ── Wajib ────────────────────────────────────────────────────────────────
# PostgreSQL saja. Server-side only; JANGAN pernah memakai prefix NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Opsional: kredensial DDL terpisah khusus migrasi (disarankan di produksi).
# MIGRATION_DATABASE_URL=postgresql://MIGRATOR:PASSWORD@HOST:5432/DBNAME

# URL publik aplikasi (dipakai untuk CORS allowlist & tautan undangan). WAJIB di produksi.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Email transaksional (OTP verifikasi/reset + undangan) ────────────────
# Jika SMTP_HOST kosong: mode DEV (OTP hanya via header X-Dev-OTP, hanya NODE_ENV != production).
# Di PRODUKSI tanpa SMTP, registrasi/reset ditolak (HTTP 503) agar OTP tidak pernah bocor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Admin platform / break-glass (opsional; nonaktif jika kosong) ────────
# Minimal 32 karakter. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# ── Scheduler (Vercel Cron) ──────────────────────────────────────────────
# CRON_SECRET dibuat via: npm run vercel:cron-secret  (jangan commit nilai asli)

# ── Tuning (opsional) ────────────────────────────────────────────────────
# API_RATE_LIMIT_PER_MIN=100          # per workspace, produksi
# REPORT_CACHE_TTL_SECONDS=300        # 0 = nonaktif; default nonaktif di Vercel (multi-instance)

# ── Catatan Neon ─────────────────────────────────────────────────────────
# Neon Auth direkomendasikan untuk produksi tetapi BELUM diintegrasikan di kode ini
# (auth saat ini: scrypt + sesi di PostgreSQL). Variabel berikut belum dipakai aplikasi:
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_COOKIE_SECRET=
# Object storage S3/Neon belum diintegrasikan; file memakai fallback PostgreSQL (3 MB/file, kuota 200 MB).
# AWS_ENDPOINT_URL_S3=  AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=  AWS_REGION=  NEON_BUCKET_NAME=
